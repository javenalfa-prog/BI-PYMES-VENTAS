# Configuración DaaS BI - Copiar a .env y completar

# Google AI Studio / Gemini (nivel gratuito disponible en ai.google.com)
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI

# WhatsApp Administrador (destinatario del reporte ejecutivo)
ADMIN_WHATSAPP=+52XXXXXXXXXX   # formato internacional ej: +5215512345678

# Opción A: Twilio (coste por mensaje, nivel de prueba gratuito)
TWILIO_ACCOUNT_SID=TU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN
TWILIO_FROM=+1XXXXXXXXXX       # número Twilio de WhatsApp

# Opción B: WhatsApp Cloud API (Meta) - desarrollo gratuito
WHATSAPP_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=123456789

# Objetivo de ventas mensual del negocio (moneda local)
MONTHLY_SALES_TARGET=50000

# Coste directo estimado por defecto si el archivo no trae columna de coste (ej 0.35 = 35%)
DEFAULT_COST_RATIO=0.35
